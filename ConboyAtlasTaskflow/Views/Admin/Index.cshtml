@using ConboyAtlasTaskflow.Data
@model IEnumerable<InstructorModel>;

@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>

<p>Admin needs to do what..?</p>

<p>
    And admin needs crud functionality for instructors and students.
</p>

@* count stats *@
<div class="row g-4">
    
    @* instructor *@
    <div class="col-12 col-sm-6">
        <div class="card h-100 border-0 bg-white p-4 shadow-sm" style="border-radius: 16px;">
            <div class="d-flex flex-column justify-content-between h-100">
                <span class="text-secondary small text-uppercase tracking-wider mb-2">Instructors</span>
                <span class="display-4 fw-light text-dark lh-1 tracking-tight">0</span>
            </div>
        </div>
    </div>

    @* student *@
    <div class="col-12 col-sm-6">
        <div class="card h-100 border-0 bg-white p-4 shadow-sm" style="border-radius: 16px;">
            <div class="d-flex flex-column justify-content-between h-100">
                <span class="text-secondary small text-uppercase tracking-wider mb-2">Students</span>
                <span class="display-4 fw-light text-dark lh-1 tracking-tight">0</span>
            </div>
        </div>
    </div>
</div>

<br />

<div class="d-flex justify-content-between align-items-center w-100">
    <h2 class="m-0">Active Instructors</h2>
    <a class="btn btn-primary" asp-controller="Admin" asp-action="Create">Create Instructor</a>
</div>

<hr class="text-muted my-4">


@foreach (var instructor in Model)
{
    <p>@instructor.LastName</p>
}


<table class="table table-striped">
  <thead>
    <tr>
      <th scope="col">First Name</th>
      <th scope="col">Last Name</th>
      <th scope="col">Email</th>
      <th scope="col">Subject</th>
    </tr>
  </thead>
