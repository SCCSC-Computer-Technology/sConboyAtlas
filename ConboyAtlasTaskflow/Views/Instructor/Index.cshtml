@using ConboyAtlasTaskflow.Data
@model IEnumerable<CourseModel>;

@{
    ViewData["Title"] = "Instructor Dashboard";
}

<h1>Instructor Dashboard</h1>



<p>Instructors can manage courses, assignments, and students here.</p>

<p>Wireframes show left and right views. Left is of instructor course assignments and their due dates</p>
<p>Right is monthly calendar view.</p>

@* count stats *@
<div class="row g-4">

    @* courses *@
    <div class="col-12 col-sm-6">
        <div class="card h-100 border border-secondary-subtle bg-white p-4 shadow-sm" style="border-radius: 16px;">
            <div class="d-flex flex-column justify-content-between h-100">
                <span class="text-secondary small text-uppercase tracking-wider mb-2">Courses</span>
                <span class="display-4 fw-light text-dark lh-1 tracking-tight">0</span>
            </div>
        </div>
    </div>

    @* students *@
    <div class="col-12 col-sm-6">
        <div class="card h-100 border border-secondary-subtle bg-white p-4 shadow-sm" style="border-radius: 16px;">
            <div class="d-flex flex-column justify-content-between h-100">
                <span class="text-secondary small text-uppercase tracking-wider mb-2">Students</span>
                <span class="display-4 fw-light text-dark lh-1 tracking-tight">0</span>
            </div>
        </div>
    </div>
</div>


