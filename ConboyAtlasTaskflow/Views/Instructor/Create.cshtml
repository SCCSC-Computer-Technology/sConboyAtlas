@{
    ViewData["Title"] = "Create Course";
}

<H1>Create A Course</H1>

@* need a form to take in course data *@

<div style="max-width: 500px; margin-top: 2rem;">
  <form method="post">
    @* course name *@
    <div class="mb-3">
      <label for="Name" class="form-label fw-semibold text-secondary">Course Name</label>
      <input type="text" class="form-control form-control-lg" id="Name" name="Name" placeholder="CPT 298 SaaS" required>
    </div>

    @* course code *@
    <div class="mb-3">
      <label for="Code" class="form-label fw-semibold text-secondary">Course Code</label>
      <input type="text" class="form-control form-control-lg" id="Code" name="Code" placeholder="A01H" required>
    </div>

    @* instructor id *@
    @* need to add user Id as a value still. *@
    <div class="mb-3">
      <input type="hidden" class="form-control form-control-lg" id="InstructorId" name="InstructorId" required>
    </div>

    @* submit button *@
    <button type="submit" class="btn btn-primary btn-lg px-5">
      Create Instructor
    </button>
  </form>
</div>