@model IEnumerable<atlasTaskflow.Models.TaskModel>

@{
    ViewData["Title"] = "My Tasks";
    var assignments = ViewBag.Assignments as IEnumerable<atlasTaskflow.Models.StudentAssignmentModel> ?? Enumerable.Empty<atlasTaskflow.Models.StudentAssignmentModel>();
    var tasks = Model.ToList();
    var dueDates = tasks.Select(x => x.DueDate.Date).Concat(assignments.Where(x => x.Assignment != null).Select(x => x.Assignment!.DueDate.Date)).ToHashSet();
    var month = DateTime.Today;
    var firstDay = new DateTime(month.Year, month.Month, 1);
    var daysInMonth = DateTime.DaysInMonth(month.Year, month.Month);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>My Tasks</h1>
    <a class="btn btn-primary" asp-action="Create">Create Task</a>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-7">
        <h2 class="h4">Assignments and Tasks</h2>

        @if (!assignments.Any() && !tasks.Any())
        {
            <p class="text-muted">You do not have any tasks yet.</p>
        }

        @if (assignments.Any())
        {
            <h3 class="h5 mt-4">Instructor Assignments</h3>
            <div class="d-flex flex-column gap-3">
                @foreach (var studentAssignment in assignments)
                {
                    <div class="card @(studentAssignment.IsComplete ? "border-success" : "")">
                        <div class="card-body">
                            <span class="text-muted small">@studentAssignment.Assignment?.Classroom?.Name</span>
                            <h4 class="h5 @(studentAssignment.IsComplete ? "text-decoration-line-through text-muted" : "")">@studentAssignment.Assignment?.Name</h4>
                            <p class="text-muted mb-2">@studentAssignment.Assignment?.Description</p>
                            <p class="mb-3">Due: @studentAssignment.Assignment?.DueDate.ToShortDateString()</p>
                            <form asp-action="ToggleAssignmentComplete" method="post">
                                <input type="hidden" name="id" value="@studentAssignment.Id" />
                                <button class="btn btn-sm @(studentAssignment.IsComplete ? "btn-outline-secondary" : "btn-success")" type="submit">
                                    @(studentAssignment.IsComplete ? "Mark Incomplete" : "Mark Complete")
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }

        @if (tasks.Any())
        {
            <h3 class="h5 mt-4">Personal Tasks</h3>
            <div class="d-flex flex-column gap-3">
                @foreach (var task in tasks)
                {
                    <div class="card @(task.IsComplete ? "border-success" : "")">
                        <div class="card-body">
                            <h4 class="h5 @(task.IsComplete ? "text-decoration-line-through text-muted" : "")">@task.Name</h4>
                            <p class="text-muted mb-2">@task.Description</p>
                            <p class="mb-3">Due: @task.DueDate.ToShortDateString()</p>
                            <div class="d-flex gap-2">
                                <form asp-action="ToggleComplete" method="post">
                                    <input type="hidden" name="id" value="@task.Id" />
                                    <button class="btn btn-sm @(task.IsComplete ? "btn-outline-secondary" : "btn-success")" type="submit">
                                        @(task.IsComplete ? "Mark Incomplete" : "Mark Complete")
                                    </button>
                                </form>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@task.Id">Edit</a>
                                <form asp-action="Delete" asp-route-id="@task.Id" method="post">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="col-12 col-lg-5">
        <div class="card">
            <div class="card-body">
                <h2 class="h4">@month.ToString("MMMM yyyy")</h2>
                <div class="calendar-grid mt-4">
                    @foreach (var dayName in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
                    {
                        <div class="calendar-heading">@dayName</div>
                    }
                    @for (var blank = 0; blank < (int)firstDay.DayOfWeek; blank++)
                    {
                        <div class="calendar-day calendar-empty"></div>
                    }
                    @for (var day = 1; day <= daysInMonth; day++)
                    {
                        var date = new DateTime(month.Year, month.Month, day);
                        <div class="calendar-day @(date.Date == DateTime.Today ? "calendar-today" : "")">
                            <span>@day</span>
                            @if (dueDates.Contains(date.Date))
                            {
                                <span class="calendar-dot"></span>
                            }
                        </div>
                    }
                </div>
                <p class="text-muted small mt-3 mb-0">A dot marks a day with a task or assignment due.</p>
            </div>
        </div>
    </div>
</div>
