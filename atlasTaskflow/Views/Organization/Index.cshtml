@model IEnumerable<atlasTaskflow.Models.OrganizationModel>

@{
    ViewData["Title"] = "Organizations";
}

<h1>Organizations</h1>

<p>Add or delete organizations here.</p>

<div class="col-12 col-sm-6">
    <div class="card h-100 border border-secondary-subtle bg-white p-4 shadow-sm" style="border-radius: 16px;">
        <div class="d-flex flex-column justify-content-between h-100">
            <span class="text-secondary small text-uppercase tracking-wider mb-2">Organizations</span>
            <span class="display-4 fw-light text-dark lh-1 tracking-tight">@Model.Count()</span>
        </div>
    </div>
</div>

<br />

<div class="d-flex justify-content-between align-items-center w-100">
    <h2 class="m-0">Active Organizations</h2>
    <a class="btn btn-primary" asp-controller="Organization" asp-action="Create">Create Organization</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var organization in Model)
        {
            <tr>
                <td>@organization.Name</td>
                <td class="text-end">
                    <form asp-action="Delete" asp-route-id="@organization.Id" method="post">
                        <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
