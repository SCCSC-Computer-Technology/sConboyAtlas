@model IEnumerable<atlasTaskflow.Models.StudentAssignmentModel>

@{
    var classroom = ViewBag.Classroom as atlasTaskflow.Models.ClassroomModel;
    ViewData["Title"] = classroom?.Name ?? "Class";
    var instructor = classroom?.Instructor;
    var instructorName = $"{instructor?.FirstName} {instructor?.LastName}".Trim();
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none">&larr; Back to Student Dashboard</a>
    <h1 class="mt-3">@classroom?.Name</h1>
    <p class="text-muted mb-1">Course Code: @classroom?.Code</p>
    <p class="text-muted">Instructor: @instructorName</p>
</div>

<h2 class="h4">Instructor Assignments</h2>

@if (!Model.Any())
{
    <p class="text-muted">This class does not have any assignments yet.</p>
}
else
{
    <div class="table-responsive" style="max-width: 1000px;">
        <table class="table table-hover align-middle" data-sortable-table>
            <thead>
                <tr>
                    <th><button class="sort-button" type="button" data-sort="name">Assignment</button></th>
                    <th>Description</th>
                    <th><button class="sort-button" type="button" data-sort="date">Due Date</button></th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
        @foreach (var studentAssignment in Model)
        {
            <tr class="@(studentAssignment.IsComplete ? "focus-row-complete" : "")" data-name="@studentAssignment.Assignment?.Name" data-date="@studentAssignment.Assignment?.DueDate.ToString("yyyy-MM-dd")">
                <td class="focus-task-name">@studentAssignment.Assignment?.Name</td>
                <td>@studentAssignment.Assignment?.Description</td>
                <td>@studentAssignment.Assignment?.DueDate.ToShortDateString()</td>
                <td data-task-status>@(studentAssignment.IsComplete ? "Complete" : "Open")</td>
                <td>
                    <form asp-controller="Task" asp-action="ToggleAssignmentComplete" method="post">
                        <input type="hidden" name="id" value="@studentAssignment.Id" />
                        <input class="task-complete-checkbox" type="checkbox" @(studentAssignment.IsComplete ? "checked" : "") data-completion-toggle aria-label="Mark assignment complete" />
                    </form>
                </td>
            </tr>
        }
            </tbody>
        </table>
    </div>
}
